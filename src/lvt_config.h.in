#pragma once
// Generated by CMake from lvt_config.h.in. Records which framework providers
// lvt_core was compiled with, so consumers can query support at compile time.
//
// Frameworks marked "needs .NET" additionally require a managed helper assembly
// at runtime; the native side builds without the .NET SDK, but enrichment for
// those frameworks is unavailable unless the assemblies are deployed alongside
// the TAP DLLs. See LVT_WITH_MANAGED.

#cmakedefine01 LVT_ENABLE_XAML
#cmakedefine01 LVT_ENABLE_WINUI3
#cmakedefine01 LVT_ENABLE_WPF
#cmakedefine01 LVT_ENABLE_WINFORMS
#cmakedefine01 LVT_ENABLE_AVALONIA
#cmakedefine01 LVT_ENABLE_CHROMIUM

// 1 when the managed .NET helper assemblies were built alongside this library.
// When 0, the WPF/WinForms/Avalonia providers are still compiled in but report
// their framework as unavailable at runtime unless the assemblies are supplied
// out of band.
#cmakedefine01 LVT_WITH_MANAGED
